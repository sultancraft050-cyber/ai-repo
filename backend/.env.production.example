ENVIRONMENT=production
MARKET_DATA_MODE=free
BACKEND_VERSION=0.1.0
FRONTEND_VERSION=0.1.0
NEO4J_URI=neo4j+s://your-aura-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-platform-secret
NEO4J_DATABASE=neo4j

FRONTEND_URL=https://your-domain.example
BACKEND_URL=https://api.your-domain.example
CORS_ORIGINS=https://your-domain.example
LOG_LEVEL=INFO

AUTH_REQUIRED=true
VIEWER_API_KEY=replace-with-platform-secret
ANALYST_API_KEY=replace-with-platform-secret
ADMIN_API_KEY=replace-with-platform-secret
SUPER_ADMIN_API_KEY=replace-with-platform-secret

PUBLIC_ANALYTICS_ENABLED=true
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_RATE_LIMIT_MAX_REQUESTS=120

SERPAPI_KEY=
EBAY_BROWSE_TOKEN=
BESTBUY_API_KEY=
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=

PRICING_SCHEDULER_ENABLED=false
PRICING_TOP_REFRESH_SECONDS=3600
PRICING_STANDARD_REFRESH_SECONDS=21600

PRODUCT_IMAGE_PROCESSING_ENABLED=false
PROCESSED_IMAGE_STORAGE_DIR=/app/processed-images
PROCESSED_IMAGE_PUBLIC_BASE_URL=https://api.your-domain.example/processed-images
PRODUCT_IMAGE_MAX_BYTES=5000000
OBJECT_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_BUCKET=pc-product-images
OBJECT_STORAGE_ACCESS_KEY=replace-with-platform-secret
OBJECT_STORAGE_SECRET_KEY=replace-with-platform-secret
OBJECT_STORAGE_PUBLIC_BASE_URL=https://images.your-domain.example

AUTONOMOUS_AGENTS_ENABLED=false
AUTONOMOUS_AGENT_INTERVAL_SECONDS=900
AUTONOMOUS_AGENT_MAX_PRODUCTS=6
