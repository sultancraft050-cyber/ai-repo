NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

FRONTEND_URL=http://127.0.0.1:3000
BACKEND_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
ENVIRONMENT=production
MARKET_DATA_MODE=free
PUBLIC_ANALYTICS_ENABLED=true
PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_RATE_LIMIT_MAX_REQUESTS=120

AUTH_REQUIRED=true
VIEWER_API_KEY=
ANALYST_API_KEY=
ADMIN_API_KEY=
SUPER_ADMIN_API_KEY=

SERPAPI_KEY=
EBAY_BROWSE_TOKEN=
BESTBUY_API_KEY=
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=

PRICING_SCHEDULER_ENABLED=true
PRICING_TOP_REFRESH_SECONDS=3600
PRICING_STANDARD_REFRESH_SECONDS=21600

AUTONOMOUS_AGENTS_ENABLED=true
AUTONOMOUS_AGENT_INTERVAL_SECONDS=900
AUTONOMOUS_AGENT_MAX_PRODUCTS=6
